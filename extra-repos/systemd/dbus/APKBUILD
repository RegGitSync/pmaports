# Forked from Alpine to enable systemd
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=dbus
_pkgver=1.16.4
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="Freedesktop.org message bus system"
url="https://www.freedesktop.org/Software/dbus"
# armhf: pmb#2618
arch="all !armhf"
license="AFL-2.1 OR GPL-2.0-or-later"
depends_dev="util-linux-dev"
pkggroups="messagebus"
provider_priority=1
install="$pkgname.pre-install"
triggers="$pkgname.trigger=/usr/share/dbus-1/system.d"
# !check: tests don't pass in pmbootstrap
options="!check"
depends="
	dbus-libs
	libexpat
"
makedepends="
	$depends_dev
	expat-dev
	glib-dev
	libselinux-dev
	libsm-dev
	libx11-dev
	meson
	xmlto
	libcap-getcap
	systemd-stage0-dev
	systemd-stage0-libs
	"
subpackages="
	$pkgname-daemon-launch-helper:launchhelper
	$pkgname-dev
	$pkgname-doc
	$pkgname-libs
	$pkgname-x11
	$pkgname-systemd
	"
source="https://dbus.freedesktop.org/releases/dbus/dbus-$_pkgver.tar.xz"
builddir="$srcdir/dbus-$_pkgver"

# secfixes:
#   1.14.4-r0:
#     - CVE-2022-42010
#     - CVE-2022-42011
#     - CVE-2022-42012
#   1.12.18-r0:
#     - CVE-2020-12049
#   1.12.16-r0:
#     - CVE-2019-12749

build() {
	abuild-meson \
		-Dsystem_pid_file=/run/dbus/dbus.pid \
		-Dselinux=enabled \
		output .
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	depends="$pkgname-libs=$pkgver-r$pkgrel"

	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# can't install tmpfs
	rm -r "$pkgdir"/run
}

libs() {
	pkgdesc="D-BUS access libraries"
	depends="systemd-stage0-libs"

	amove usr/lib/lib*.so.*
}

x11() {
	pkgdesc="X11 add-ons for D-BUS"
	depends="$pkgname=$pkgver-r$pkgrel"

	amove usr/bin/dbus-launch
}

launchhelper() {
	pkgdesc="DBus SUID launch helper for autospawning"
	install_if="$pkgname=$pkgver-r$pkgrel"

	amove usr/libexec/dbus-daemon-launch-helper

	chmod 4750 "$subpkgdir"/usr/libexec/dbus-daemon-launch-helper
	chown root:messagebus "$subpkgdir"/usr/libexec/dbus-daemon-launch-helper
}

dev() {
	default_dev
}

sha512sums="
edcd1102184e4a81da905a7a554531bcba74d4e037240c27b3cf1af8ed308df6ae6182fd8af0c98894c56b6d24100787893d6a86e430f4077c23c8a3a5f530a2  dbus-1.16.4.tar.xz
"
